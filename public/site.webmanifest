{
  "name": "Captions Bro",
  "short_name": "Captions Bro",
  "description": "In-browser video editor with AI captions, animated subtitles, and one-click H.264 MP4 export — nothing leaves your device.",
  "lang": "en-US",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#15181d",
  "theme_color": "#1d222a",
  "categories": ["photo", "video", "productivity"],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/us/app/edits-video-editor/id6738967378",
      "id": "6738967378"
    }
  ],
  "icons": [
    {
      "src": "/app-icon-192.png?v=2",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-512.png?v=2",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app-icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/app-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "2560x1600",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The Captions Bro editor: media bin, 16:9 preview with a burned-in caption, and the timeline."
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "860x1864",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "The Captions Bro editor on a phone: preview, timeline and the media dock."
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "name": "Video or image",
      "accept": {
        "video/mp4": [".mp4", ".m4v"],
        "video/quicktime": [".mov"],
        "video/webm": [".webm"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/webp": [".webp"],
        "image/gif": [".gif"]
      }
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "image/*"]
        }
      ]
    }
  }
}
